# CONSINZO Environment Configuration
# Copy to .env.local for local development. Never commit .env or .env.local.

# --- Public App Configuration ---
NEXT_PUBLIC_APP_NAME=CONSINZO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Free Tier) ---
# Create a free-tier project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-Only Credentials (NEVER expose to browser or client bundles) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CONSINZO_PRIVATE_BUCKET=consinzo-private

# --- Local Fallback / Dev Mode ---
# When Supabase keys are not yet configured, local dev uses signed HTTP-only cookies
# and a local file-backed SQLite/JSON store in .data/ for testing only.
# Production deployments MUST configure Supabase PostgreSQL and Auth.
CONSINZO_AUTH_SECRET=replace-with-32-byte-random-hex-for-local-dev
CONSINZO_DATA_DIR=.data

# --- Execution & Free-Tier Quota Controls ---
CONSINZO_ENABLE_LOCAL_EVM_RUNNER=true
CONSINZO_ENABLE_REMOTE_ACTIONS_EVAL=false
CONSINZO_MAX_SUBMISSIONS_PER_HOUR=20
CONSINZO_MAX_PROJECT_BYTES=262144
CONSINZO_EXECUTION_TIMEOUT_MS=15000

# --- GitHub Actions Remote Evaluation (Optional / Restricted) ---
# Only set if using an isolated GitHub Actions dispatch workflow with no untrusted PR checkout.
GITHUB_ACTIONS_EVAL_TOKEN=
GITHUB_ACTIONS_EVAL_REPO=

# --- Sign-in methods ---
# Password and wallet (Sign-In with Ethereum) sign-in always work and need no provider.
# The methods below are delivered by Supabase Auth. Enable the provider in the Supabase
# dashboard (Authentication -> Providers) first, then switch its flag on here. With the
# flag off the button is not shown, so users never hit a provider that is not set up.
# Add  <your-site>/auth/callback  to Supabase "Redirect URLs".
CONSINZO_AUTH_GOOGLE=false
CONSINZO_AUTH_GITHUB=false
CONSINZO_AUTH_EMAIL_CODE=false
# Phone sign-in needs an SMS provider (for example Twilio) configured in Supabase.
CONSINZO_AUTH_PHONE=false
# Without Supabase, email and phone codes work only outside production: the code is shown
# on the page instead of being sent. They are disabled in production builds.

# --- Public contact channels (each is shown only when set) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_FARCASTER=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
